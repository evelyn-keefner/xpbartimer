# Int getPointsNumberFromSeconds(Float seconds)
@fast

@define Float fractional_second_time = seconds - (1.0 * xpbartimer::getLevelNumberFromSeconds(seconds))
@define Int maxPointsNeeded = xpbartimer::getXPPointsForLevel(xpbartimer::getLevelNumberFromSeconds(seconds))
@return Int((1.0 * maxPointsNeeded) * fractional_second_time)